rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /class-files/{classCode}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /kriah-bench/{uid}/{file} {
      // only the bench admin can listen; keep in sync with ADMIN_EMAILS in public/kriah-test-bench.html
      allow read: if request.auth != null && request.auth.token.email == 'jhein1@mail.yu.edu';
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.size < 25 * 1024 * 1024
                    && request.resource.contentType.matches('audio/.*');
    }
  }
}
