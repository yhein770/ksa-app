rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
      match /homework-audio/{assignmentId}/{fileName} {
      allow write: if request.auth != null
        && (fileName == request.auth.token.email.lower() + '.webm'
            || fileName == request.auth.token.email.lower() + '.m4a'
            || fileName == request.auth.token.email.lower() + '.ogg')
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');
      allow read: if request.auth != null
        && (fileName == request.auth.token.email.lower() + '.webm'
            || fileName == request.auth.token.email.lower() + '.m4a'
            || fileName == request.auth.token.email.lower() + '.ogg'
            || firestore.exists(/databases/(default)/documents/teachers/$(request.auth.token.email)));
    }
    match /class-files/{classCode}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /kriah-bench/{uid}/{file} {
      // only the bench admin can listen; keep in sync with ADMIN_EMAILS in public/kriah-test-bench.html
      allow read: if request.auth != null && request.auth.token.email == 'jhein1@mail.yu.edu';
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.size < 25 * 1024 * 1024
                    && request.resource.contentType.matches('audio/.*');
    }
  }
}
